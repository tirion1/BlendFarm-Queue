<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LogicReinc.BlendFarm.Controls.QueuePanel">
  <Border BorderBrush="#333333" BorderThickness="1,0,0,0" Background="#222222">
    <StackPanel Margin="0,10,0,10">
      <TextBlock x:Name="queueSummary" Margin="5,0,5,8" TextWrapping="Wrap" Foreground="#FFCC00" FontSize="15" />
      <ListBox Items="{Binding ServerQueue}" Height="300">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Canvas Height="50">
              <StackPanel Canvas.Top="0" Canvas.Left="0" Width="240">
                <TextBlock Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Foreground="#AAAAAA" FontSize="11" />
              </StackPanel>
              <Button Width="70" Height="30" Canvas.Top="8" Canvas.Right="5"
                  IsVisible="{Binding CanPromote}"
                  Background="#400083" BorderBrush="#200041"
                  Command="{Binding MoveToFront}">Move to front</Button>
            </Canvas>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Margin="5,10,5,0" TextWrapping="Wrap" Foreground="#888888" FontSize="11">Only the computer hosting the server can move jobs to the front. Other computers can see the queue and their own position.</TextBlock>
    </StackPanel>
  </Border>
</UserControl>
