<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogicReinc.BlendFarm.Controls;assembly=LogicReinc.BlendFarm"
             x:Class="LogicReinc.BlendFarm.Controls.ServerSidebar">
  <Border BorderBrush="#333333" BorderThickness="1,0,0,0" Background="#222222">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="10,20,10,10">
        <!--Collapsed by default, the headers tell enough to know whether it is worth opening-->
        <Expander x:Name="nodesExpander" IsExpanded="False" Margin="0,0,0,8">
          <Expander.Header>
            <TextBlock x:Name="nodesHeader" FontSize="15" FontWeight="Bold">Select Nodes</TextBlock>
          </Expander.Header>
          <local:NodePanel x:Name="nodePanel" />
        </Expander>
        <Expander x:Name="queueExpander" IsExpanded="False">
          <Expander.Header>
            <TextBlock x:Name="queueHeader" FontSize="15" FontWeight="Bold">Current Queue</TextBlock>
          </Expander.Header>
          <local:QueuePanel x:Name="queuePanel" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
